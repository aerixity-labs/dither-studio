# --- Site ---
# Public origin for metadataBase, canonical URLs, robots, the sitemap and llms.txt.
# Precedence: this variable, then VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
# Set it in Vercel Production too, so the canonical host cannot change when domains move.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# VERCEL_ENV and VERCEL_PROJECT_PRODUCTION_URL are injected by the platform. Do not set
# VERCEL_ENV locally: it gates the noindex rules, so forcing "production" on a dev server
# would publish an indexable page.
