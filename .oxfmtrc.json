{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "quoteProps": "as-needed",
  "sortImports": true,
  "sortTailwindcss": {
    "functions": ["cn", "cva", "clsx", "twMerge"]
  },
  "ignorePatterns": [".next/**", "node_modules/**"]
}
